PORT=4173
DB_CLIENT=mysql
DATABASE_URL=mysql://root:your_mysql_password@127.0.0.1:3306/paperbriq

# Remote machine control is disabled unless this is explicitly true.
REMOTE_CONTROL_ENABLED=false

# Comma-separated IDs of trusted admin or barangay staff accounts allowed to
# control paperbriq-esp32 after signing in. Demo mode never grants sessions.
MACHINE_OPERATOR_IDS=

# Machine key for the demo admin's thesis phone or trusted integrations.
CONTROL_API_KEY=

# Device key used only by the ESP32 for telemetry, commands, and events.
IOT_API_KEY=replace-with-a-long-random-device-key

# Optional command/presence timing (seconds).
DEVICE_COMMAND_TTL_SECONDS=120
DEVICE_ONLINE_SECONDS=60
IOT_TELEMETRY_ONLINE_SECONDS=20
